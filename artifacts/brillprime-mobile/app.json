{
  "expo": {
    "name": "BrillPrime",
    "slug": "brillprime-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "brillprime",
    "userInterfaceStyle": "automatic",
    "platforms": ["ios", "android", "web"],
    "ios": {
      "bundleIdentifier": "com.brillprime.app",
      "buildNumber": "1",
      "supportsTablet": true
    },
    "android": {
      "package": "com.brillprime.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#073B32"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/icon.png",
      "name": "BrillPrime",
      "shortName": "BrillPrime",
      "themeColor": "#073B32",
      "backgroundColor": "#F6F8F6"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#073B32"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
